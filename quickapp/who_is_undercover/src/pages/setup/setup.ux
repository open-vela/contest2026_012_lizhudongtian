<template>
  <scroll class="page" scroll-y="true">
    <text class="title">谁是卧底</text>
    <text class="subtitle">单机 · 一块表轮流玩</text>

    <text class="section-label">玩家人数</text>
    <div class="option-row">
      <div class="chip {{playerCount === $item ? 'chip-active' : ''}}"
           for="{{counts}}" onclick="selectCount($item)">
        <text class="chip-text">{{$item}}</text>
      </div>
    </div>

    <text class="section-label">难度</text>
    <div class="option-row">
      <div class="chip-wide {{difficulty === $item.v ? 'chip-active' : ''}}"
           for="{{levels}}" onclick="selectLevel($item.v)">
        <text class="chip-text">{{$item.label}}</text>
      </div>
    </div>

    <div class="start-btn" onclick="start">
      <text class="start-text">开始游戏</text>
    </div>
    <text class="hint">{{undercoverHint}}</text>
  </scroll>
</template>

<script>
import router from '@system.router'
import game from '../../common/game.js'

export default {
  private: {
    counts: [4, 5, 6, 7, 8],
    levels: [
      { v: 1, label: '简单' },
      { v: 2, label: '困难' },
      { v: 0, label: '混合' }
    ],
    playerCount: 6,
    difficulty: 1
  },

  computed: {
    undercoverHint() {
      const n = this.playerCount > 5 ? 2 : 1
      return this.playerCount + ' 人局 · ' + n + ' 名卧底'
    }
  },

  selectCount(n) {
    this.playerCount = n
  },

  selectLevel(v) {
    this.difficulty = v
  },

  start() {
    game.newGame(this.playerCount, this.difficulty)
    router.replace({ uri: '/pages/deal' })
  }
}
</script>

