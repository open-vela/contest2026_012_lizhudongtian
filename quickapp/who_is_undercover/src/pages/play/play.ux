  font-size: 24px;
  color: #888888;
  margin-bottom: 8px;
}

.order-label {
  font-size: 20px;
  color: #888888;
  margin-bottom: 8px;
}

.order-list {
  width: 320px;
  height: 180px;
  flex-direction: column;
}

.order-item {
  width: 100%;
  height: 48px;
  flex-direction: row;
  align-items: center;
  background-color: #111111;
  border-radius: 10px;
  margin-bottom: 8px;
  padding-left: 16px;
}

.order-idx {
  width: 36px;
  font-size: 22px;
  color: #4CAF50;
}

.order-name {
  font-size: 24px;
  color: #ffffff;
}

.who {
  font-size: 26px;
  color: #aaaaaa;
  margin-bottom: 12px;
}

.vote-list {
  width: 340px;
  height: 300px;
  flex-direction: column;
}

.vote-item {
  width: 100%;
  height: 60px;
  justify-content: center;
  align-items: center;
  background-color: #1a1a1a;
  border-radius: 30px;
  margin-bottom: 10px;
}

.vote-name {
  font-size: 26px;
  color: #ffffff;
}

.vote-picked {
  background-color: #4CAF50;
}

.out-info {
  font-size: 32px;
  font-weight: bold;
  color: #ffffff;
  margin-bottom: 8px;
}

.out-role {
  font-size: 24px;
  color: #FFB74D;
  margin-bottom: 20px;
}

.win-title {
  font-size: 36px;
  font-weight: bold;
  color: #4CAF50;
  margin-bottom: 16px;
}

.reveal-list {
  width: 360px;
  height: 240px;
  flex-direction: column;
}

.reveal-item {
  width: 100%;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  height: 46px;
  background-color: #111111;
  border-radius: 10px;
  margin-bottom: 8px;
  padding-left: 16px;
  padding-right: 16px;
}

.reveal-name {
  font-size: 22px;
  color: #ffffff;
}

.reveal-role {
  font-size: 20px;
}

.role-under {
  color: #FF6B6B;
}

.role-civ {
  color: #888888;
}

.action-btn {
  width: 240px;
  height: 64px;
  justify-content: center;
  align-items: center;
  background-color: #4CAF50;
  border-radius: 32px;
  margin-top: 24px;
}

.action-text {
  font-size: 26px;
  font-weight: bold;
  color: #ffffff;
}
</style>
