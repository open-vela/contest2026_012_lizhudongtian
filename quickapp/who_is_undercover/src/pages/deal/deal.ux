<template>
  <div class="page">
    <text class="step">发牌 {{index + 1}} / {{total}}</text>
    <text class="who">请把手表交给</text>
    <text class="name">{{currentName}}</text>

    <!-- 词语直接展示 -->
    <div class="card">
      <text class="word">{{currentWord}}</text>
    </div>

    <div class="next-btn" onclick="next">
      <text class="next-text">{{isLast ? '开始描述' : '下一位'}}</text>
    </div>
  </div>
</template>

<script>
import router from '@system.router'
import game from '../../common/game.js'

export default {
  private: {
    index: 0,
    total: 0,
    currentName: '',
    currentWord: ''
  },

  computed: {
    isLast() {
      return this.index >= this.total - 1
    }
  },

  onInit() {
    const s = game.getState()
    this.total = s.players.length
    this.loadCurrent()
  },

  loadCurrent() {
    const s = game.getState()
    const p = s.players[this.index]
    if (p) {
      this.currentName = p.name
      this.currentWord = p.word
    }
  },

  next() {
    if (this.isLast) {
      game.startPlaying()
      router.replace({ uri: '/pages/play' })
      return
    }
    this.index += 1
    this.loadCurrent()
  }
}
</script>

<style>
.page {
  width: 480px;
  height: 480px;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  background-color: #000000;
}

.step {
  font-size: 22px;
  color: #888888;
  margin-bottom: 10px;
}

.who {
  font-size: 24px;
  color: #aaaaaa;
}

.name {
  font-size: 40px;
  font-weight: bold;
  color: #ffffff;
  margin-top: 4px;
  margin-bottom: 24px;
}

.card {
  width: 300px;
  height: 160px;
  justify-content: center;
  align-items: center;
  background-color: #14351c;
  border-radius: 20px;
}

.word {
  font-size: 56px;
  font-weight: bold;
  color: #4CAF50;
}

.next-btn {
  width: 240px;
  height: 64px;
  justify-content: center;
  align-items: center;
  background-color: #4CAF50;
  border-radius: 32px;
  margin-top: 28px;
}

.next-text {
  font-size: 26px;
  font-weight: bold;
  color: #ffffff;
}
</style>
