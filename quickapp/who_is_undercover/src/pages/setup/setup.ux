  font-size: 20px;
  color: #888888;
  margin-top: 4px;
  margin-bottom: 20px;
}

.section-label {
  font-size: 22px;
  color: #aaaaaa;
  margin-top: 12px;
  margin-bottom: 10px;
}

.option-row {
  width: 100%;
  flex-direction: row;
  flex-wrap: wrap;
  justify-content: center;
}

.chip {
  width: 60px;
  height: 60px;
  justify-content: center;
  align-items: center;
  background-color: #1a1a1a;
  border-radius: 30px;
  margin: 6px;
}

.chip-wide {
  width: 96px;
  height: 56px;
  justify-content: center;
  align-items: center;
  background-color: #1a1a1a;
  border-radius: 28px;
  margin: 6px;
}

.chip-active {
  background-color: #4CAF50;
}

.chip-text {
  font-size: 26px;
  color: #ffffff;
}

.start-btn {
  width: 100%;
  height: 68px;
  justify-content: center;
  align-items: center;
  background-color: #4CAF50;
  border-radius: 34px;
  margin-top: 28px;
}

.start-text {
  font-size: 28px;
  font-weight: bold;
  color: #ffffff;
}

.hint {
  font-size: 20px;
  color: #666666;
  margin-top: 14px;
}
</style>
